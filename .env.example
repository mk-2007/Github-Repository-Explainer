# Choose LLM Provider: "gemini" (recommended for high limits) or "groq"
LLM_PROVIDER=gemini

# Google Gemini API (Recommended: 1M token context, high RPM/TPM)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API (Alternative: free tier ~6k TPM, 30 RPM)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# GitHub Personal Access Token (Raises GitHub rate limits from 60/hr to 5,000/hr)
# Get a free classic token (no scopes needed for public repos) at https://github.com/settings/tokens
GITHUB_TOKEN=

# PostgreSQL Database Connection
# Local Postgres, Docker Compose, or hosted (Neon / Supabase)
DATABASE_URL=postgresql://repoexplainer:repoexplainer@localhost:5432/repo_explainer
