# Generate your own free key at https://console.groq.com (no card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generate at https://github.com/settings/tokens (classic, no scopes needed for public repos)
# Raises GitHub's rate limit from 60/hr to 5,000/hr
GITHUB_TOKEN=

# --- If running WITHOUT Docker (npm run dev directly) ---
# Local Postgres, or a free-tier hosted instance (Neon/Supabase both work).
# Copy this whole file to `.env.local` and fill this in too.
DATABASE_URL=postgresql://user:password@localhost:5432/repo_explainer

# --- If running via Docker Compose instead ---
# docker-compose reads a file named exactly `.env` (not `.env.local`) in
# this same folder. You only need GROQ_API_KEY and GITHUB_TOKEN in it —
# DATABASE_URL is already fixed in docker-compose.yml to point at the
# Postgres container, so leave it out of `.env` entirely.

