# Generate your own free key at https://console.groq.com (no card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Generate at https://github.com/settings/tokens (classic, no scopes needed for public repos)
# Raises GitHub's rate limit from 60/hr to 5,000/hr
GITHUB_TOKEN=

# Local Postgres, or a free-tier hosted instance (Neon/Supabase both work)
DATABASE_URL=postgresql://user:password@localhost:5432/repo_explainer
